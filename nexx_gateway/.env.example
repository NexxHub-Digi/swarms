# INTERNAL server-to-server secrets only. Never commit real keys or expose this gateway in a browser.
# Generate one unique API token per consuming project: python -c 'import secrets; print(secrets.token_urlsafe(48))'
NEXX_DEFAULT_MODEL=groq/openai/gpt-oss-20b
NEXX_MAX_CONCURRENT_RUNS=2
# Supply NEXX_PROJECTS_JSON as a secret environment variable or mounted secret, e.g.:
# {"nexx-ai":{"api_key":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS","workflows":["research","creative","software","operations"],"requests_per_minute":10},"nexx-eventpass":{"api_key":"DIFFERENT_32_PLUS_RANDOM_CHARACTERS","workflows":["operations","support","creative"],"requests_per_minute":5}}
# NEXX_PROJECTS_JSON=
# GROQ_API_KEY=  # Only on the private worker. Optional if a different approved provider is configured.
